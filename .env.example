# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values — .env* is gitignored.

# Neon Postgres connection string (from Neon console or the connector)
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Long random string for signing admin sessions (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# Single-admin login. Set the email you'll log in with, and a bcrypt hash of your password.
# Generate the hash locally (never share the plaintext):
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=$2a$10$replace_with_generated_bcrypt_hash
