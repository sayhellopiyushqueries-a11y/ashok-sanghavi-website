# Copy to .env.local for local dev, and set in Vercel → Settings → Environment Variables.
# .env* is gitignored — never commit real values.

# The ONLY variable the deployment needs. Neon Postgres connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Everything else lives in the database:
#   - JWT signing secret → app_settings ('jwt_secret')
#   - Admin login (email + bcrypt password hash) → admin_users
# The admin password can be changed from the panel (Change password page).

# Optional local fallback only (ignored in production, DB value wins):
# JWT_SECRET=any-long-random-string
